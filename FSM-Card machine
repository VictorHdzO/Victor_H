							estado_main <= SUBIDA1;---volvemos a mover a todos los jugadores
						end if;
						
					else
						 estado_main <= SUBIDA2;
					end if;
				else
					contador_clk <= contador_clk + 1;
				end if;

		when MOTORREDUCTOR_ON =>
			AuxPlayers <= AuxPlayers +1 ;
			step_int <= '0'; -- motor detenido-=========
			MOTOR <= '1';
                
			 if contador < TimeEncendido then
				  contador <= contador + 1;
			 else
				  contador <= 0;
				  estado_main <= MOTORREDUCTOR_OFF;  -- Cambia al estado APAGADO
			 end if;
			
		when MOTORREDUCTOR_OFF =>
			 MOTOR <= '0';
			 --------======Timer de espera de dos segundos util para el futuro-======
			 if Contador < Timer2 then
				  Contador <= Contador + 1;
			 else
				  Contador <= 0;
				  contador_pasos <= 0;
				  --estado_main <= HOLD_MAIN; -- o IDLE si deseas
				  estado_main <= HOLD_MAIN;
			 end if;
          --estado_main <= HOLD_MAIN;

				
		when HOLD_MAIN =>
--		-------ULTIMO JUGADOR ----
			if AuxPlayers = Players then 
				AuxCartas <= AuxCartas + 1;---aumentar el numeor de cartas
				AuxPlayers <= 0;
				estado_main <= SUBIDA2;--PARA REGREDASR
			else 
				estado_main <= SUBIDA1;
			end if;
				
	end case;-----FIN FSM MAIN
	
	end if;-----IF principla del rising edge del CLK
	
